# 复制为 .env.local 后填入实际值

# ─── AI luận giải (máy chủ theo chuẩn OpenAI /chat/completions, ví dụ codex-lb) ───
# Không điền thì trang vẫn lập lá số bình thường, phần luận giải báo "chưa bật".
# Khoá chỉ dùng ở server (app/api/*), không gửi xuống trình duyệt.
AI_BASE_URL=https://codex.example.com/v1
AI_API_KEY=your-api-key
AI_MODEL=gpt-6.1-sol
# Giới hạn để người lạ không dùng hết hạn mức: số lượt mỗi IP trong 15 phút, số lượt chạy cùng lúc
AI_RATE_LIMIT_PER_15M=30
AI_MAX_CONCURRENT=4

# ─── 站点 ───
NEXT_PUBLIC_SITE_URL=http://localhost:3000
